# Podium environment variables (copy to .env and fill in)

# Google Gemini API key — required for LLM intelligence (Phase 3C+)
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Max tokens per Gemini call (default: 1024)
# GEMINI_MAX_TOKENS=1024

# Set to false to disable LLM calls (deterministic fallback in Phase 3D)
# LLM_ENABLED=true

# SQLite database path (default: data/podium.db)
# DATABASE_PATH=data/podium.db

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
